{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "michishirube-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  // アプリのドメイン。サーバー（/api/*）と、トップページ・プライバシーポリシー（site/）を同じドメインで配る。
  // Google の審査には、ホームページとプライバシーポリシーが承認済みドメインにあることが要る。
  // 前の URL（workers.dev）も動いたままにして、前の版のアプリがつながるようにする
  "routes": [{ "pattern": "latte.makimura.me", "custom_domain": true }],
  "assets": { "directory": "./site", "run_worker_first": ["/api/*"] },
  // ダッシュボードで登録した変数（FEEDBACK_NOTIFY_TO / FEEDBACK_NOTIFY_FROM）を、デプロイで消さない。
  // 宛先のメールアドレスをリポジトリに書かないため、設定ファイルではなくダッシュボードに置く
  "keep_vars": true,
  "vars": {
    // アプリを開くオリジン。カンマ区切り
    "ALLOWED_ORIGINS": "https://makim0939.github.io,http://localhost:5179,http://localhost:5180,capacitor://localhost,https://localhost"
  },
  // database_id を書かないと、初回の deploy で自動作成される
  "d1_databases": [{ "binding": "DB", "database_name": "michishirube", "migrations_dir": "./migrations" }],
  // 要望が届いたときの通知メール。宛先は、Email Routing で確認済みのアドレスだけ
  "send_email": [{ "name": "MAIL" }],
  // ログインしなくても使える窓口（認可の開始・ご意見）の、接続元（IP）ごとの回数の制限。
  // 全体の上限（D1 で数える）だけだと、ひとりの相手が使い切って、ほかの人が使えなくなるため。
  // 数はデータセンターごとに数えるおおよそのもの。namespace_id は、このアカウントの中で重ならない番号なら何でもよい
  "ratelimits": [
    { "name": "AUTH_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "FEEDBACK_LIMITER", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } }
  ]
  // シークレット（wrangler secret put で登録）: APP_TOKEN, GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET
}

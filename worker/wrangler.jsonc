{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "michishirube-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "vars": {
    // アプリを開くオリジン。カンマ区切り
    "ALLOWED_ORIGINS": "https://makim0939.github.io,http://localhost:5179,http://localhost:5180"
  },
  // database_id を書かないと、初回の deploy で自動作成される
  "d1_databases": [{ "binding": "DB", "database_name": "michishirube", "migrations_dir": "./migrations" }]
  // シークレット（wrangler secret put で登録）: APP_TOKEN, GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET
}

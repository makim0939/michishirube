{
  "name": "michishirube",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker",
    "icons": "pwa-assets-generator",
    "worker:dev": "wrangler dev --config worker/wrangler.jsonc --port 8787",
    "worker:migrate": "wrangler d1 migrations apply michishirube --config worker/wrangler.jsonc",
    "worker:deploy": "wrangler deploy --config worker/wrangler.jsonc"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@xyflow/react": "^12.11.6",
    "dexie": "^4.4.5",
    "dexie-react-hooks": "^4.4.0",
    "fflate": "^0.8.2",
    "hono": "^4.13.11",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261007.1",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vite-pwa/assets-generator": "^1.0.4",
    "@vitejs/plugin-react": "^6.1.1",
    "fake-indexeddb": "^6.2.4",
    "typescript": "~5.9.3",
    "vite": "^8.2.4",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.2",
    "wrangler": "^4.147.0"
  },
  "packageManager": "pnpm@10.7.0"
}
